.page { padding: 0 0 40rpx; }

.filterbar {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--bg);
  overflow-x: auto;
  white-space: nowrap;
}
.chip {
  flex: none;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--sub);
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(20, 40, 90, 0.05);
}
.chip.on {
  background: var(--brand);
  color: #fff;
}

.list { padding: 4rpx 24rpx; }

.day-group { margin-bottom: 8rpx; }
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 6rpx 14rpx;
}
.day-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  position: relative;
  padding-left: 22rpx;
}
.day-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--brand);
}
.day-count { font-size: 23rpx; color: var(--muted); }

.news-card {
  display: flex;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(20, 40, 90, 0.06);
  padding: 26rpx;
  margin-bottom: 22rpx;
}
.nc-body { flex: 1; min-width: 0; }
.nc-tagline { display: flex; align-items: center; margin-bottom: 8rpx; }
.nc-source { color: var(--muted); font-size: 22rpx; }
.nc-title {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nc-summary {
  margin-top: 10rpx;
  color: var(--sub);
  font-size: 25rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nc-meta { margin-top: 14rpx; color: var(--muted); font-size: 22rpx; }
.nc-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-left: 22rpx;
  flex: none;
  background: #f0f2f6;
}

.weekly-hero {
  margin: 12rpx 0 26rpx;
  padding: 38rpx 32rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #07162f, #174b83);
  box-shadow: 0 12rpx 34rpx rgba(7, 36, 78, 0.18);
}
.weekly-kicker {
  color: #79baff;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.weekly-title {
  margin-top: 15rpx;
  font-size: 39rpx;
  line-height: 1.4;
  font-weight: 700;
}
.weekly-period {
  margin-top: 12rpx;
  color: #a9c8e8;
  font-size: 23rpx;
}
.weekly-summary {
  margin-top: 22rpx;
  color: #e1efff;
  font-size: 27rpx;
  line-height: 1.7;
}
.weekly-number {
  width: 54rpx;
  flex: none;
  padding-top: 2rpx;
  color: var(--brand);
  font-size: 25rpx;
  font-weight: 700;
}
.weekly-all {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(20, 40, 90, 0.06);
}
.weekly-all-title {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 600;
}
.weekly-all-sub {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
}
.weekly-all-arrow {
  color: var(--brand);
  font-size: 52rpx;
  line-height: 1;
}
